---
import "@/styles/global.css";

import Footer from "@components/Footer/Footer.astro";
import Nav from "@components/Nav/Nav.astro";
import BaseHead from "@layouts/BaseHead.astro";

// heroImage and authorData are defined on blog posts
// authorData could also be defined on the about author page
interface Props {
	type?: "general";
	navStartStyle?: "default" | "white";
	title: string;
	description: string;
	heroImage?: ImageMetadata;
	noindex?: boolean; // you need to opt-in to no indexing, as it hides the page from search engines
}

const {
	type = "general",
	navStartStyle = "default",
	title,
	description,
	heroImage,
	noindex = false,
} = Astro.props as Props;
---

<!doctype html>
<html lang="en" transition:animate="fade">
	<head>
		<BaseHead
			type={type}
			title={title}
			description={description}
			image={heroImage ? heroImage : undefined}
			noindex={noindex}
		/>
	</head>
	<body id="body" class="bg-base-50 text-base-900">
		<div id="page-loading" class="page-loading" aria-live="polite" aria-label="Cargando pagina">
			<div class="page-loading__bar"></div>
		</div>
		<div class="min-h-[100lvh]">
			<Nav startStyle={navStartStyle} />
			<main>
				<slot />
			</main>
		</div>
		<Footer />
	</body>
</html>

<script>
	const loading = document.querySelector<HTMLElement>("#page-loading");
	let loadingTimeout: number | undefined;

	function showLoading() {
		if (!loading) return;
		window.clearTimeout(loadingTimeout);
		loading.classList.add("is-loading");
	}

	function hideLoading() {
		if (!loading) return;
		loading.classList.remove("is-loading");
	}

	document.addEventListener("astro:before-preparation", showLoading);
	document.addEventListener("astro:after-swap", () => {
		loadingTimeout = window.setTimeout(hideLoading, 150);
	});
	document.addEventListener("astro:page-load", hideLoading);
</script>

<style>
	.page-loading {
		position: fixed;
		inset: 0 0 auto;
		z-index: 100;
		height: 3px;
		pointer-events: none;
		opacity: 0;
		transition: opacity 0.2s ease;
	}

	.page-loading__bar {
		height: 100%;
		width: 35%;
		background: var(--color-primary-500);
		transform: translateX(-110%);
	}

	.page-loading.is-loading {
		opacity: 1;
	}

	.page-loading.is-loading .page-loading__bar {
		animation: page-loading 1s ease-in-out infinite;
	}

	@keyframes page-loading {
		from { transform: translateX(-110%); }
		to { transform: translateX(320%); }
	}
</style>
