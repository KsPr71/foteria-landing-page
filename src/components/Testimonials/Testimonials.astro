---
/**
 * Testimonial groups rotate client-side so every collection entry can appear.
 */

import TestimonialCard from "@components/TestimonialCard/TestimonialCard.astro";
import { getCollection } from "astro:content";
import sitioConfig from "@config/sitio-config";

const testimonials = await getCollection("testimonials");
const sortedTestimonials = [...testimonials].sort((a, b) => a.data.order - b.data.order);
const testimonialsPerGroup = 3;
const testimonialGroups = Array.from(
	{ length: Math.ceil(sortedTestimonials.length / testimonialsPerGroup) },
	(_, groupIndex) => Array.from(
		{ length: Math.min(testimonialsPerGroup, sortedTestimonials.length) },
		(_, index) => sortedTestimonials[(groupIndex * testimonialsPerGroup + index) % sortedTestimonials.length],
	),
);
---

<section id="testimonial" class="site-container scroll-mt-10 py-8 md:py-12">
	<div class="mx-auto max-w-6xl text-center">
		<h2 class="h2 text-pretty uppercase">{sitioConfig["testimonials-title"]}</h2>
	</div>
	{testimonialGroups.length > 0 && <div class="testimonial-rotator pt-8 md:pt-12" data-testimonial-rotator>
		{testimonialGroups.map((group, groupIndex) => (
			<div class:list={["testimonial-group", { "is-active": groupIndex === 0 }]} data-testimonial-group aria-hidden={groupIndex === 0 ? "false" : "true"}>
				<div class="mx-auto grid max-w-md gap-20 lg:max-w-none lg:grid-cols-3">
					{group.map((testimonial, index) => <TestimonialCard testimonial={testimonial} imagePosition={index === 1 ? "bottom" : "top"} />)}
				</div>
			</div>
		))}
	</div>}
</section>

<script>
	let testimonialTimer: number | undefined;

	function setupTestimonials() {
		window.clearInterval(testimonialTimer);
		const groups = [...document.querySelectorAll<HTMLElement>("[data-testimonial-group]")];
		if (groups.length < 2 || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

		let activeIndex = Math.floor(Math.random() * groups.length);
		groups.forEach((group, index) => {
			const active = index === activeIndex;
			group.classList.toggle("is-active", active);
			group.setAttribute("aria-hidden", String(!active));
		});

		testimonialTimer = window.setInterval(() => {
			let nextIndex = activeIndex;
			while (nextIndex === activeIndex) nextIndex = Math.floor(Math.random() * groups.length);
			groups[activeIndex].classList.remove("is-active");
			groups[activeIndex].setAttribute("aria-hidden", "true");
			groups[nextIndex].classList.add("is-active");
			groups[nextIndex].setAttribute("aria-hidden", "false");
			activeIndex = nextIndex;
		}, 9000);
	}

	setupTestimonials();
	document.addEventListener("astro:after-swap", setupTestimonials);
	document.addEventListener("astro:before-swap", () => window.clearInterval(testimonialTimer));
</script>

<style>
	.testimonial-rotator { display: grid; }
	.testimonial-group {
		grid-area: 1 / 1;
		opacity: 0;
		pointer-events: none;
		transition: opacity 1.25s ease-in-out;
	}
	.testimonial-group.is-active { opacity: 1; pointer-events: auto; }
	@media (prefers-reduced-motion: reduce) {
		.testimonial-group { transition: none; }
	}
</style>
