---
import defaultSocialImage from "@assets/images/hero-bg-min.png";
import siteData from "@config/siteData.json";
import { getImage } from "astro:assets";
import { SEO } from "astro-seo";

interface BaseProps {
	title: string;
	description: string;
	noindex?: boolean;
}

interface GenProps extends BaseProps {
	type: "general" | undefined;
	image?: ImageMetadata;
}

const { title = "general", description, image, noindex = false } = Astro.props as GenProps;

const socialImage = image || defaultSocialImage;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);

// Facebook recommends a large 1.91:1 image. Astro generates it at build time.
const optimizedImage = await getImage({
	src: socialImage,
	format: "jpg",
	quality: 90,
	width: 1200,
	height: 630,
	fit: "cover",
});
const imageUrl = new URL(optimizedImage.src, Astro.site).toString();
const imageAlt = title;
---

<SEO
	title={title}
	description={description}
	canonical={canonicalUrl.toString()}
	openGraph={{
		basic: {
			title: title,
			type: "website",
			image: imageUrl,
			url: canonicalUrl.toString(),
		},
		optional: {
			description: description,
			siteName: siteData.title,
		},
		image: {
			type: "image/jpeg",
			width: "1200",
			height: "630",
			alt: imageAlt,
		},
	}}
	twitter={{
		site: "@" + siteData.author.twitter,
		creator: "@" + siteData.author.twitter,
		card: "summary_large_image",
		title: title,
		description: description,
		image: imageUrl,
	}}
	noindex={noindex}
	nofollow={noindex}
/>

<meta property="og:locale" content="es_ES" />
<meta property="og:image:secure_url" content={imageUrl} />
