---
/**
 * * Hero with background image
 * You'll want a mobile image, and a desktop image for this.
 */

import Button from "@components/Button/Button.astro";
import { Image } from "astro:assets";
import sitioConfig from "@config/sitio-config";
---

<section id="hero" class="relative z-10 flex min-h-[100lvh] w-full">
	<!-- background image -->
	<div class="absolute -z-10 h-full min-h-full w-full overflow-hidden" data-hero-parallax>
		<div class="absolute inset-0 bg-black/10"></div>

		<Image
			src={sitioConfig["hero-image"]}
			class="hidden h-auto min-h-full w-full object-cover object-bottom sm:block"
			alt={sitioConfig["hero-image-alt"]}
			aria-hidden="true"
			loading="eager"
			height={1400}
		/>
		<Image
			src={sitioConfig["hero-mobile-image"]}
			class="h-auto min-h-full w-full object-cover sm:hidden"
			alt={sitioConfig["hero-image-alt"]}
			aria-hidden="true"
			loading="eager"
			width={1200}
		/>
	</div>

	<!-- hero items -->
	<div class="site-container relative w-full gap-10 py-44 text-center md:py-52 md:text-left">
		<!-- Hero text -->

		<div class="text-base-50 my-auto mr-auto max-w-[800px] flex-col">
		 	
			<h1
				class="font-heading-1 text-4xl font-semibold text-[#F5840E] text-pretty drop-shadow-[0_2px_2px_rgba(0,0,0,0.4)] md:text-7xl md:leading-tight"
			>
				{sitioConfig["hero-title"]}
			</h1>
			<h1
				class="font-heading-1 text-4xl font-semibold text-[#00000] drop-shadow-[0_2px_2px_rgba(0,0,0,0.4)] md:text-7xl md:leading-tight"
			>
				{sitioConfig["hero-subtitle"]}
			</h1>

			<p
				class="mt-8 text-lg tracking-widest text-pretty drop-shadow-[0_1px_1px_rgba(0,0,0,0.2)] md:max-w-[550px] md:text-2xl"
			>
				{sitioConfig["hero-description"]}
			</p>
	
			<div class="mt-10 flex flex-wrap justify-center gap-4 md:justify-start">
				<Button
					variant="ghost"
					arrow="right"
					href={sitioConfig["hero-cta-link"]}
					class="pl-0 text-xl text-white drop-shadow-[0_1px_1px_rgba(0,0,0,0.2)] md:text-3xl"
				>
					{sitioConfig["hero-cta-label"]}
				</Button>
			</div>
		</div>
	</div>
</section>

<script>
	let animationFrame: number | undefined;
	const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

	function updateParallax() {
		animationFrame = undefined;

		if (prefersReducedMotion.matches) return;

		document.querySelectorAll<HTMLElement>("[data-hero-parallax]").forEach((background) => {
			const hero = background.closest<HTMLElement>("#hero");
			if (!hero) return;

			const { top } = hero.getBoundingClientRect();
			background.style.transform = `translate3d(0, ${top * 0.22}px, 0) scale(1.12)`;
		});
	}

	function requestParallaxUpdate() {
		if (animationFrame) return;
		animationFrame = window.requestAnimationFrame(updateParallax);
	}

	document.addEventListener("astro:page-load", requestParallaxUpdate);
	document.addEventListener("scroll", requestParallaxUpdate, { passive: true });
	window.addEventListener("resize", requestParallaxUpdate);
	prefersReducedMotion.addEventListener("change", requestParallaxUpdate);
	requestParallaxUpdate();
</script>

<style>
	[data-hero-parallax] {
		will-change: transform;
	}

	@media (prefers-reduced-motion: reduce) {
		[data-hero-parallax] {
			transform: none !important;
		}
	}
</style>
