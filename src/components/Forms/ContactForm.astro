---
import Button from "@components/Button/Button.astro";
import sitioConfig from "@config/sitio-config";
---

<form id="contact-form" name="contact form" class="flex h-full flex-col justify-between gap-4">
	<input type="hidden" name="form-name" value="contact" />
	<div>
		<label for="contact-name" class="font-heading-1 text-lg uppercase">{sitioConfig["contact-name-label"]}</label>
		<input type="text" class="form__input" name="name" id="contact-name" placeholder="" required />
	</div>
	<div class="flex flex-col gap-1">
		<label for="contact-email" class="font-heading-1 text-lg uppercase">{sitioConfig["contact-email-label"]}</label>
		<input
			type="tel"
			class="form__input"
			name="email"
			id="contact-email"
			inputmode="tel"
			placeholder=""
			required
		/>
	</div>
	<div>
		<label for="contact-date" class="font-heading-1 text-lg uppercase">{sitioConfig["contact-date-label"]}</label>
		<input type="date" class="form__input" name="date" id="contact-date" placeholder="" required />
	</div>
	<div>
		<label for="contact-message" class="font-heading-1 text-lg uppercase">{sitioConfig["contact-message-label"]}</label>
		<textarea
			name="message"
			class="form__input"
			id="contact-message"
			rows="6"
			placeholder=""
			required></textarea>
	</div>
	<div class="flex">
		<Button variant="primary" type="submit" class="w-full px-10 md:w-fit">{sitioConfig["contact-submit-label"]}</Button>
	</div>
</form>

<script define:vars={{ whatsappNumber: sitioConfig["contact-whatsapp-number"] }}>
	const form = document.querySelector("#contact-form");

	form?.addEventListener("submit", (event) => {
		event.preventDefault();
		const data = new FormData(form);
		const message = [
			"Hola, deseo hacer una reserva.",
			`Nombre: ${String(data.get("name") ?? "").trim()}`,
			`Teléfono: ${String(data.get("email") ?? "").trim()}`,
			`Fecha deseada: ${String(data.get("date") ?? "").trim()}`,
			`Mensaje: ${String(data.get("message") ?? "").trim()}`,
		].join("\n");

		window.location.href = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}`;
	});
</script>
