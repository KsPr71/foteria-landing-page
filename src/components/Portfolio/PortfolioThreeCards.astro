---
import Button from "@components/Button/Button.astro";
import PortfolioCard from "@components/PortfolioCard/PortfolioCard.astro";
import sitioConfig from "@config/sitio-config";
import { getStoragePortfolios } from "@/lib/storage-portfolios";

const portfolios = await getStoragePortfolios();
const firstThreePortfolios = portfolios.slice(0, 3);
const portfolioData = portfolios.map(({ slug, title, description, coverImage, coverPosition }) => ({ slug, title, description, coverImage, coverPosition }));
---

<section id="portfolio" class="site-container mt-12 scroll-mt-10 py-8 md:py-12">
	<div class="mx-auto max-w-6xl text-center"><h2 class="h2 text-pretty uppercase">{sitioConfig["portfolio-title"]}</h2></div>
	{firstThreePortfolios.length > 0 && <div class="portfolio-rotator grid gap-10 pt-8 transition-opacity duration-300 md:grid-cols-2 md:pt-12" data-portfolio-rotator data-portfolios={JSON.stringify(portfolioData)}>
		<div data-portfolio-slot="featured" class="md:bg-base-100 md:rounded-md md:p-10 md:pb-6"><PortfolioCard portfolio={firstThreePortfolios[0]} direction="vertical" /></div>
		<div class="flex h-full flex-col justify-between gap-y-6">
			{firstThreePortfolios.slice(1).map((portfolio, index) => <><div data-portfolio-slot="secondary"><PortfolioCard portfolio={portfolio} direction="horizontal" /></div>{index === 0 && firstThreePortfolios.length > 2 && <hr class="border-base-100 hidden border md:block" />}</>)}
		</div>
	</div>}
	<div class="mt-12 flex justify-center"><Button href={sitioConfig["portfolio-view-all-link"]} variant="outline">{sitioConfig["portfolio-view-all-label"]}</Button></div>
</section>

<script>
	type PortfolioPreview = {
		slug: string;
		title: string;
		description: string;
		coverImage: string;
		coverPosition: string;
	};

	function shuffle<T>(items: T[]) {
		const result = [...items];
		for (let index = result.length - 1; index > 0; index -= 1) {
			const randomIndex = Math.floor(Math.random() * (index + 1));
			[result[index], result[randomIndex]] = [result[randomIndex], result[index]];
		}
		return result;
	}

	function updatePortfolioCard(card: HTMLElement, portfolio: PortfolioPreview) {
		card.querySelectorAll<HTMLAnchorElement>("a").forEach((link) => { link.href = `/portfolio/${portfolio.slug}`; });
		const image = card.querySelector<HTMLImageElement>("img");
		if (image) {
			image.src = portfolio.coverImage;
			image.alt = portfolio.title;
			image.style.objectPosition = portfolio.coverPosition;
		}
		const title = card.querySelector("h3");
		const description = card.querySelector("p");
		if (title) title.textContent = portfolio.title;
		if (description) description.textContent = portfolio.description;
	}

	function randomizePortfolios() {
		const rotator = document.querySelector<HTMLElement>("[data-portfolio-rotator]");
		if (!rotator) return;
		const portfolios = JSON.parse(rotator.dataset.portfolios || "[]") as PortfolioPreview[];
		if (portfolios.length < 2) return;

		const selected = shuffle(portfolios);
		const cards = [
			rotator.querySelector<HTMLElement>('[data-portfolio-slot="featured"]'),
			...rotator.querySelectorAll<HTMLElement>('[data-portfolio-slot="secondary"]'),
		].filter((card): card is HTMLElement => card !== null);

		rotator.classList.add("opacity-0");
		window.setTimeout(() => {
			cards.forEach((card, index) => {
				if (selected[index]) updatePortfolioCard(card, selected[index]);
			});
			requestAnimationFrame(() => rotator.classList.remove("opacity-0"));
		}, 200);
	}

	randomizePortfolios();
	document.addEventListener("astro:after-swap", randomizePortfolios);
</script>
