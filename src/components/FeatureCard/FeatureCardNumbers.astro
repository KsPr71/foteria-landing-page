---
/**
 * * These are cards with a large number, and description below
 */

interface Props {
	largeText: string;
	description: string;
	rest?: any; // catch-all for any additional parameters, such as "aria-label"
}

const { largeText, description, ...rest } = Astro.props as Props;
---

<div {...rest} class="flex flex-col gap-2 text-center sm:gap-3">
	<h3 class="font-decorative text-primary-500 text-[4.5rem] leading-none sm:text-[5.5rem] lg:text-[6.5rem]">
		{largeText}
	</h3>

	<p class="description font-heading-1 text-base sm:text-lg lg:text-xl">
		{description}
	</p>
</div>
