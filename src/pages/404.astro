---
// main layout
// components
import Button from "@components/Button/Button.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import sitioConfig from "@config/sitio-config";
---

<BaseLayout title={sitioConfig["not-found-page-title"]} description={sitioConfig["not-found-page-description"]} noindex={true}>
	<section class="site-container pt-36 text-center md:pt-44">
		<div class="mx-auto max-w-xl px-4 text-center">
			<h1 class="h1">{sitioConfig["not-found-title"]}</h1>
			<p class="description mt-4">
				{sitioConfig["not-found-description"]}
			</p>
			<div class="mt-8 flex justify-center">
				<Button variant="primary" href={sitioConfig["not-found-cta-link"]}>{sitioConfig["not-found-cta-label"]}</Button>
			</div>
		</div>
	</section>
</BaseLayout>
