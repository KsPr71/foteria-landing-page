---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getStoragePortfolios } from "@/lib/storage-portfolios";

export async function getStaticPaths() {
	const portfolios = await getStoragePortfolios();
	return portfolios.map((portfolio) => ({ params: { slug: portfolio.slug }, props: { portfolio } }));
}

const { portfolio } = Astro.props;
---

<BaseLayout title={portfolio.title} description={portfolio.description} navStartStyle="white">
	<div class="relative h-[40svh] w-full overflow-hidden md:h-[60svh]">
		<div class="absolute inset-0 z-10 bg-black/30"></div>
		<img src={portfolio.heroImage} alt={portfolio.title} style={`object-position: ${portfolio.bannerPosition};`} class="absolute inset-0 h-full w-full object-cover" loading="eager" />
	</div>

	<article class="mx-auto mt-12 px-4 md:mt-20 md:max-w-6xl">
		<h1 class="h1 description mt-4 text-center uppercase">{portfolio.title}</h1>
		<h2 class="h3 text-primary-500 mt-10 flex flex-col items-center justify-center gap-x-3 gap-y-1 tracking-widest md:flex-row">
			<div>{portfolio.clients.join(" & ")}</div>
			<span class="hidden md:inline">|</span>
			<hr class="border-primary-400 w-1/3 md:hidden" />
			<span>{portfolio.location}</span>
		</h2>
		<div class="description mt-6 text-center text-pretty md:text-lg">
			<p>{portfolio.body}</p>
		</div>
		<div class="mx-auto mt-12 max-w-5xl space-y-6 md:mt-20 md:space-y-16">
			{portfolio.images.map((group) => (
				<div class:list={["grid gap-6 md:gap-16", { "grid-cols-1": group.length === 1, "grid-cols-2": group.length === 2, "grid-cols-3": group.length === 3, "grid-cols-4": group.length === 4 }]}>
					{group.map((image) => <img src={image} alt="Imagen del portafolio" class="h-auto w-full object-cover" loading="lazy" />)}
				</div>
			))}
		</div>
	</article>
</BaseLayout>
